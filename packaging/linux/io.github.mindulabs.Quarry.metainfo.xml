<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mindulabs.Quarry</id>
  <name>Quarry</name>
  <summary>Query and edit your databases</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <developer id="io.github.mindulabs">
    <name>Quarry contributors</name>
  </developer>
  <description>
    <p>Quarry is a fast, open-source database client for MySQL, MariaDB, PostgreSQL and Microsoft SQL Server. Browse schemas, run SQL, edit rows, and import and export data, with every write on a production connection asking first. Each database driver is downloaded the first time you need it.</p>
    <p>Quarry is in early development.</p>
  </description>
  <launchable type="desktop-id">io.github.mindulabs.Quarry.desktop</launchable>
  <url type="homepage">https://github.com/MinduLabs/quarry</url>
  <url type="bugtracker">https://github.com/MinduLabs/quarry/issues</url>
  <url type="vcs-browser">https://github.com/MinduLabs/quarry</url>
  <content_rating type="oars-1.1"/>
  <branding>
    <color type="primary" scheme_preference="light">#d9dee4</color>
    <color type="primary" scheme_preference="dark">#3d4a57</color>
  </branding>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <!-- metainfo.sh adds this version's release from Cargo.toml at build time. -->
  <releases/>
</component>
