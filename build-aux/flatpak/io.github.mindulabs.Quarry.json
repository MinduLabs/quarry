{
  "id": "io.github.mindulabs.Quarry",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "quarry",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/quarry/cargo",
      "CARGO_NET_OFFLINE": "true",
      "QUARRY_LOCALEDIR": "/app/share/locale"
    }
  },
  "cleanup": ["/include", "/lib/pkgconfig", "*.a"],
  "modules": [
    {
      "name": "quarry",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline build --release --locked -p quarry",
        "install -Dm755 target/release/quarry /app/bin/quarry",
        "install -Dm644 data/io.github.mindulabs.Quarry.desktop -t /app/share/applications",
        "install -Dm644 data/io.github.mindulabs.Quarry.metainfo.xml -t /app/share/metainfo",
        "install -Dm644 data/icons/hicolor/scalable/apps/io.github.mindulabs.Quarry.svg -t /app/share/icons/hicolor/scalable/apps",
        "install -Dm644 data/icons/hicolor/symbolic/apps/io.github.mindulabs.Quarry-symbolic.svg -t /app/share/icons/hicolor/symbolic/apps"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": ["target", "dist", ".flatpak-builder", ".flatpak-repo", ".git"]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
