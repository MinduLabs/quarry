{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quarry",
  "identifier": "io.github.mindulabs.Quarry",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": ".." },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": ".." }
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Quarry",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Fast, native-feeling database client",
    "copyright": "Quarry contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "desktopTemplate": "../packaging/linux/tauri.desktop" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "../packaging/macos/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  },
  "plugins": {
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGOUFCNjA5NTNGMUU4MzUKUldRMTZQRlRDYmFhenhBaEdQMXNKcXg1Sk9vemplcEZPTTEvUEtYaU91NEVCTUYwKzhpVUQwaUsK",
      "endpoints": ["https://github.com/MinduLabs/quarry/releases/latest/download/latest.json"]
    }
  }
}
